say "Hello World!"
say "This is my Test.uvnn"
say "Heres some add and subtract action."

set health, 100 # This is a comment
say "Initulized health to 100."
say $health

set heal, 20
set damage, 10
say "Initulized heal to 20 and damage to 10."
# another comment
add $health, $heal
say $health
say "Healed health." 

sub $health, $damage
say $health
say "Damaged health."

say "Here some multiplying and dividing now."
set mlt, 4.5
say "Set mlt to 4.5"
say "We'll multiply by 16."

mlt $mlt, 16
say $mlt

say "Now lets divide!"
say "Set div to 2."
set div, 2
say "We'll divide by 3."

div $div, 3
say $div