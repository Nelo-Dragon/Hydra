# ==========================================================
# Hydra Test Script
# Tests:
#   - say
#   - set
#   - add / sub / mlt / div
#   - variables
#   - kill
#   - nested if statements
#   - ask
# ==========================================================

say "=== Hydra Runtime Test ==="

# ----------------------------------------------------------
# Variables
# ----------------------------------------------------------

say ""
say "[Variable Test]"

set player, "Aretē"
set health, 100
set gold, 50

say "Player:"
say $player

say "Health:"
say $health

say "Gold:"
say $gold


# ----------------------------------------------------------
# Math
# ----------------------------------------------------------

say ""
say "[Math Test]"

set heal, 25
set damage, 10
set multiplier, 2
set divisor, 4

say "Healing..."

add $health, $heal
say $health

say "Taking damage..."

sub $health, $damage
say $health

say "Doubling health..."

mlt $health, $multiplier
say $health

say "Dividing health by four..."

div $health, $divisor
say $health


# ----------------------------------------------------------
# Floats
# ----------------------------------------------------------

say ""
say "[Float Test]"

set pi, 3.14159
say $pi

mlt $pi, 2
say $pi

div $pi, 2
say $pi


# ----------------------------------------------------------
# Kill
# ----------------------------------------------------------

say ""
say "[Kill Test]"

set temp, "Temporary Variable"

say $temp

kill temp

say "Variable removed."

say $temp


# ----------------------------------------------------------
# If Statements
# ----------------------------------------------------------

say ""
say "[If Test]"

set score, 75

if $score >= 50

    say "Passed!"

endIf

if $score < 50

    say "This should NOT appear."

endIf


# ----------------------------------------------------------
# Nested Ifs
# ----------------------------------------------------------

say ""
say "[Nested If Test]"

set hasKey, 1
set doorOpen, 0

if $hasKey = 1

    say "Player has the key."

    if $doorOpen = 0

        say "The door is locked."

    endIf

endIf

say "Nested test complete."

# ----------------------------------------------------------
# Ask
# ----------------------------------------------------------

ask input, "Type something: "

say $input

# ----------------------------------------------------------
# Finished
# ----------------------------------------------------------

say ""
say "=== End of Test ==="