# ==========================================================
# Hydra Test Script
# Tests:
#   - say
#   - set
#   - add / sub / mult / div
#   - variables
#   - kill
#   - nested if statements
#   - ask
# ==========================================================

say "=== Hydra Runtime Test ==="

# ----------------------------------------------------------
# Variables
# ----------------------------------------------------------

say ""
say "[Variable Test]"

set player, "Aretē"
set health, 100
set gold, 50

say "Player:"
say $player

say "Health:"
say $health

say "Gold:"
say $gold


# ----------------------------------------------------------
# Math
# ----------------------------------------------------------

say ""
say "[Math Test]"

set heal, 25
set damage, 10
set multiplier, 2
set divisor, 4

say "Healing..."

add $health, $heal
say $health

say "Taking damage..."

sub $health, $damage
say $health

say "Doubling health..."

mult $health, $multiplier
say $health

say "Dividing health by four..."

div $health, $divisor
say $health


# ----------------------------------------------------------
# Floats
# ----------------------------------------------------------

say ""
say "[Float Test]"

set pi, 3.14159
say $pi

mult $pi, 2
say $pi

div $pi, 2
say $pi


# ----------------------------------------------------------
# Kill
# ----------------------------------------------------------

say ""
say "[Kill Test]"

set temp, "Temporary Variable"

say $temp

kill temp

say "Variable removed."

say $temp


# ----------------------------------------------------------
# If Statements
# ----------------------------------------------------------

say "[If Test]"

set a, 10

if $a = 10

    say "Passed!"

else

    say "FAILED!"

endIf

say ""

say "[Else Test]"

set a, 5

if $a = 10
    say "FAILED!"
else
    say "Else works!"
endIf

# ----------------------------------------------------------
# Nested Ifs
# ----------------------------------------------------------

say ""

say "[Nested If Test]"

set hasKey, 1
set doorUnlocked, 0

if $hasKey = 1
    say "Player has the key."

    if $doorUnlocked = 1
        say "The door is open."
    else
        say "The door is locked."
    endIf

else
    say "Player has no key."
endIf

say "Nested test complete."

# ----------------------------------------------------------
# Ask
# ----------------------------------------------------------

say ""
say "[Ask Test]"

ask input, "Type something: "

say $input

ask a, "Type a number: "
ask b, "Type another number: "

add $a, $b

say "those two numbers equal:"
say $a

# ----------------------------------------------------------
# Finished
# ----------------------------------------------------------

say ""
say "=== End of Test ==="